---
import PageLayout from '../layouts/PageLayout.astro'
import {imageUrl} from '../lib/image'
import {getPrintEditions} from '../lib/queries'

const editions = await getPrintEditions()

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
]
// issueMonth is "YYYY-MM" -- parsed by hand rather than `new Date()` to avoid
// any timezone shifting a month-only value into the wrong month/year.
function formatIssueMonth(issueMonth: string) {
  const [year, month] = issueMonth.split('-').map(Number)
  return `${MONTH_NAMES[month - 1]} ${year}`
}
---

<PageLayout
  title="Print Editions"
  kicker="Archive"
  intro="Past print editions of The Caravel, available as PDFs."
  wide
>
  {
    editions.length === 0 ? (
      <p>No print editions yet.</p>
    ) : (
      <ul class="print-grid">
        {editions.map((e) => (
          <li class="print-grid__item">
            <a href={e.pdfUrl} target="_blank" rel="noopener" class="print-grid__cover">
              {e.coverImage ? (
                <img src={imageUrl(e.coverImage, {width: 320})} alt={e.coverImage.alt ?? `${e.title} cover`} />
              ) : (
                <span class="print-grid__placeholder">{e.title}</span>
              )}
            </a>
            <p class="print-grid__title">
              <a href={e.pdfUrl} target="_blank" rel="noopener">
                {e.title}
              </a>
            </p>
            <p class="print-grid__date">{formatIssueMonth(e.issueMonth)}</p>
          </li>
        ))}
      </ul>
    )
  }
</PageLayout>

<style>
  .print-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4) var(--space-3);
  }
  .print-grid__item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .print-grid__cover {
    display: block;
    border: 1px solid var(--rule-strong);
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }
  .print-grid__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .print-grid__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--paper-sunk);
    color: var(--ink-faint);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-align: center;
    padding: var(--space-2);
  }
  .print-grid__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    margin: 0;
  }
  .print-grid__title a {
    color: var(--ink);
  }
  .print-grid__date {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin: 0;
  }
</style>
