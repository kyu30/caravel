---
import PageLayout from '../layouts/PageLayout.astro'
import ArticleCard from '../components/ArticleCard.astro'
import {getAllArticlesChrono} from '../lib/queries'
import type {ArticleCardData} from '../lib/types'

const articles = await getAllArticlesChrono()

// Bucket by calendar year. publishDate is an ISO-8601 UTC string, so the first
// four characters are the year — timezone-stable, no Date allocation.
const groups = new Map<string, ArticleCardData[]>()
for (const a of articles) {
  const year = a.publishDate.slice(0, 4)
  const bucket = groups.get(year)
  if (bucket) bucket.push(a)
  else groups.set(year, [a])
}
const years = [...groups.entries()].sort((a, b) => Number(b[0]) - Number(a[0]))
---

<PageLayout
  title="Archive"
  kicker="Browse by year"
  intro="Every article The Caravel has published, grouped by year."
  wide
>
  {
    years.length === 0 ? (
      <p>Nothing published yet.</p>
    ) : (
      <>
        <div class="archive__toolbar">
          <button id="archive-sort" type="button" aria-pressed="false">
            Sort: Newest first
          </button>
        </div>
        <div id="archive-years">
          {years.map(([year, list]) => (
            <section class="archive__year" data-year={year}>
              <h2 class="archive__heading">
                <span>{year}</span>
                <span class="archive__count">
                  {list.length} article{list.length === 1 ? '' : 's'}
                </span>
              </h2>
              <ul class="archive__list">
                {list.map((a) => (
                  <li>
                    <ArticleCard
                      article={a}
                      variant="row"
                      showImage={false}
                      showExcerpt={false}
                      headingLevel={3}
                    />
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </>
    )
  }
</PageLayout>

<script>
  const button = document.getElementById('archive-sort') as HTMLButtonElement | null
  const container = document.getElementById('archive-years')
  if (button && container) {
    let newestFirst = true
    button.addEventListener('click', () => {
      const sections = [...container.children]
      sections.reverse().forEach((s) => container.appendChild(s))
      newestFirst = !newestFirst
      button.textContent = `Sort: ${newestFirst ? 'Newest' : 'Oldest'} first`
      button.setAttribute('aria-pressed', String(!newestFirst))
    })
  }
</script>

<style>
  .archive__toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
  }
  .archive__toolbar button {
    font-family: var(--font-ui);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--step--1);
    padding: 0.6rem 1.1rem;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    cursor: pointer;
  }
  .archive__toolbar button:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .archive__year {
    margin-bottom: var(--space-5);
  }
  .archive__heading {
    font-family: var(--font-display);
    font-size: var(--step-2);
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 2px solid var(--rule-strong);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
  }
  .archive__count {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    font-weight: 400;
  }
  .archive__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .archive__list :global(.card--row:last-child) {
    border-bottom: 0;
  }
</style>
