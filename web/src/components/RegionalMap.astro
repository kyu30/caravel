---
import type {Taxonomy} from '../lib/types'
import {MAP_SHAPES} from '../lib/mapShapes'

interface Props {
  regions: Taxonomy[]
}
const {regions} = Astro.props

/**
 * Interactive map — hover-swap PNG frames (mapchart.net exports) + invisible
 * SVG-clipped hit-areas traced from the actual highlighted pixels in each
 * source image. See /docs/MAP_PLAN.md for the full design writeup.
 *
 * FIRST PASS: the "swana" and "eeca" source images (MECA.png / EER.png) don't
 * yet match those regions' real coverage (North Africa / Central Asia are
 * misplaced — see docs/MAP_PLAN.md). Swap those two PNGs once regenerated;
 * everything else here — the stacking, hit-area tracing, and interaction —
 * stays the same.
 */
const withShapes = regions.filter((r) => r.mapId && MAP_SHAPES[r.mapId])
---

<figure class="rmap">
  <div class="rmap__stage">
    <img
      class="rmap__layer rmap__layer--default"
      src="/images/map/default.png"
      alt="World map — hover or tap a region to explore The Caravel's coverage"
      width="1600"
      height="862"
    />
    {
      withShapes.map((r) => (
        <img
          class={`rmap__layer rmap__layer--${r.mapId}`}
          src={`/images/map/${r.mapId}.png`}
          alt=""
          width="1600"
          height="862"
        />
      ))
    }

    <svg width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        {
          withShapes.map((r) => (
            <clipPath id={`rmap-clip-${r.mapId}`} clipPathUnits="objectBoundingBox">
              {MAP_SHAPES[r.mapId!].map((poly) => (
                <polygon points={poly.map(([x, y]) => `${x / 100} ${y / 100}`).join(' ')} />
              ))}
            </clipPath>
          ))
        }
      </defs>
    </svg>

    {
      withShapes.map((r) => (
        <a
          href={`/${r.slug}`}
          class="rmap__hit"
          data-region={r.mapId}
          data-name={r.name}
          aria-label={r.name}
          style={`clip-path: url(#rmap-clip-${r.mapId})`}
        />
      ))
    }

    <p class="rmap__tag" aria-hidden="true"></p>
  </div>
  <figcaption>Hover or tap a region — or browse the <a href="/regions">full list</a>.</figcaption>
</figure>

<style>
  .rmap {
    margin: 0;
  }
  .rmap__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1600 / 862;
    background: var(--paper-sunk);
    border: 1px solid var(--rule);
    overflow: hidden;
  }
  .rmap__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .rmap__layer--default {
    opacity: 1;
  }
  .rmap__hit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .rmap__hit:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .rmap__tag {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    margin: 0;
    padding: 0.4rem 0.8rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
  }
  .rmap__tag.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  figcaption {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin-top: 0.6rem;
  }
</style>

<script>
  const stage = document.querySelector('.rmap__stage')
  if (stage) {
    const defaultLayer = stage.querySelector('.rmap__layer--default') as HTMLElement | null
    const tag = stage.querySelector('.rmap__tag') as HTMLElement | null
    const hits = stage.querySelectorAll('.rmap__hit')
    hits.forEach((hit) => {
      const region = hit.getAttribute('data-region')
      const name = hit.getAttribute('data-name') ?? ''
      const layer = stage.querySelector(`.rmap__layer--${region}`) as HTMLElement | null
      if (!layer || !defaultLayer) return
      const activate = () => {
        defaultLayer.style.opacity = '0'
        layer.style.opacity = '1'
        if (tag) {
          tag.textContent = name
          tag.classList.add('is-visible')
        }
      }
      const deactivate = () => {
        defaultLayer.style.opacity = '1'
        layer.style.opacity = '0'
        tag?.classList.remove('is-visible')
      }
      hit.addEventListener('mouseenter', activate)
      hit.addEventListener('mouseleave', deactivate)
      hit.addEventListener('focus', activate)
      hit.addEventListener('blur', deactivate)
    })
  }
</script>
