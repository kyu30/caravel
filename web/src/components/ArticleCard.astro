---
import type {ArticleCardData} from '../lib/types'
import {imageUrl} from '../lib/image'
import Byline from './Byline.astro'

interface Props {
  article: ArticleCardData
  variant?: 'lead' | 'standard' | 'compact' | 'row'
  showImage?: boolean
  showExcerpt?: boolean
  headingLevel?: 2 | 3 | 4
}

const {
  article,
  variant = 'standard',
  showImage = true,
  showExcerpt = variant === 'lead' || variant === 'standard',
  headingLevel = variant === 'lead' ? 2 : 3,
} = Astro.props

const Heading = `h${headingLevel}` as const
const withImage = showImage && !!article.heroImage
const sizes = {lead: 1200, standard: 640, compact: 320, row: 240}
const hero = withImage
  ? imageUrl(article.heroImage, {width: sizes[variant], height: Math.round(sizes[variant] * 0.62)})
  : null
const kicker = article.primarySection?.name
---

<article class:list={['card', `card--${variant}`, {'card--noimg': !withImage}]}>
  {
    hero && (
      <a class="card__media" href={article.url} tabindex="-1" aria-hidden="true">
        <img src={hero} alt="" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="card__body">
    {kicker && <p class="kicker card__kicker">{kicker}</p>}
    <Heading class="card__title">
      <a href={article.url}>{article.title}</a>
    </Heading>
    {
      showExcerpt && (article.excerpt || article.subtitle) && (
        <p class="card__excerpt">{article.excerpt ?? article.subtitle}</p>
      )
    }
    <Byline authors={article.authors} date={article.publishDate} class="card__byline" />
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 0.75rem;
  }
  .card__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--paper-sunk);
  }
  .card__kicker {
    margin: 0 0 0.3rem;
  }
  .card__title {
    font-family: var(--font-display);
    margin: 0;
    line-height: var(--leading-snug);
  }
  .card__title a {
    color: var(--ink);
  }
  .card__title a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .card__excerpt {
    margin: 0.5rem 0 0.6rem;
    color: var(--ink-soft);
    font-size: var(--step-0);
  }
  .card__byline {
    margin-top: 0.4rem;
  }

  /* lead — big hero, big headline */
  .card--lead .card__title {
    font-size: var(--step-3);
  }
  .card--lead .card__excerpt {
    font-size: var(--step-1);
    max-width: 60ch;
  }

  /* standard — stacked, medium */
  .card--standard .card__title {
    font-size: var(--step-1);
  }

  /* compact — small stacked, used in dense grids */
  .card--compact .card__title {
    font-size: var(--step-0);
    font-weight: 700;
  }
  .card--compact .card__excerpt {
    display: none;
  }

  /* row — horizontal, thumbnail left */
  .card--row {
    grid-template-columns: 84px 1fr;
    align-items: start;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .card--row.card--noimg {
    grid-template-columns: 1fr;
  }
  .card--row .card__media img {
    aspect-ratio: 1 / 1;
  }
  .card--row .card__title {
    font-size: var(--step-0);
    font-weight: 700;
  }
  .card--row .card__excerpt {
    display: none;
  }

  @media (max-width: 640px) {
    .card--lead .card__title {
      font-size: var(--step-2);
    }
  }
</style>
