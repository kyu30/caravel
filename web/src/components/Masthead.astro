---
import {SITE} from '../lib/site.js'

interface Props {
  compact?: boolean
}
const {compact = false} = Astro.props

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<div class:list={['masthead', {compact}]}>
  <div class="container masthead__inner">
    <p class="masthead__meta masthead__meta--left">
      <span>{today}</span>
    </p>

    <a href="/" class="masthead__wordmark" aria-label={`${SITE.name} — home`}>
      <span class="masthead__the">The</span>
      <span class="masthead__name">Caravel</span>
    </a>

    <p class="masthead__meta masthead__meta--right">
      <span>Georgetown University</span>
      <a href={SITE.newsletterUrl}>Subscribe</a>
    </p>
  </div>
  {!compact && <p class="masthead__tagline container">{SITE.tagline}</p>}
</div>

<style>
  .masthead {
    background: var(--paper);
    padding-block: var(--space-3) var(--space-2);
  }
  .masthead.compact {
    padding-block: var(--space-2);
  }
  .masthead__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-2);
  }
  .masthead__wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
    line-height: 0.9;
  }
  .masthead__wordmark:hover {
    color: var(--ink);
  }
  .masthead__the {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .masthead__name {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: 0.01em;
    font-size: var(--step-5);
    text-transform: none;
  }
  .compact .masthead__name {
    font-size: var(--step-3);
  }
  .compact .masthead__the {
    font-size: var(--step-0);
  }
  .masthead__meta {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .masthead__meta--right {
    text-align: right;
  }
  .masthead__tagline {
    font-family: var(--font-ui);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: var(--space-2) auto 0;
    padding-top: var(--space-1);
    border-top: 1px solid var(--rule);
    max-width: 32rem;
  }

  @media (max-width: 680px) {
    .masthead__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .masthead__meta {
      display: none;
    }
    .masthead__name {
      font-size: var(--step-4);
    }
  }
</style>
