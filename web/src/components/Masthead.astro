---
import {SITE} from '../lib/site.js'

interface Props {
  compact?: boolean
}
const {compact = false} = Astro.props

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'short',
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})
---

<div class:list={['masthead', {compact}]}>
  <div class="container masthead__inner">
    <a href="/" class="masthead__brand" aria-label={`${SITE.name} — home`}>
      <img class="masthead__mark" src="/CaravelLogo.png" alt="" width="44" height="33" />
      <span class="masthead__wordmark">The&nbsp;Caravel</span>
    </a>

    <div class="masthead__meta">
      <span class="masthead__date">{today}</span>
      <span class="masthead__sep" aria-hidden="true">·</span>
      <span>Georgetown University</span>
      <span class="masthead__sep" aria-hidden="true">·</span>
      <a href={SITE.newsletterUrl}>Subscribe</a>
    </div>
  </div>
</div>

<style>
  .masthead {
    background: var(--paper);
    padding-block: var(--space-3) var(--space-2);
  }
  .masthead.compact {
    padding-block: var(--space-2);
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .masthead__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
  }
  .masthead__brand:hover {
    color: var(--ink);
  }
  .masthead__mark {
    width: 44px;
    height: auto;
    flex: none;
  }
  .compact .masthead__mark {
    width: 34px;
  }
  .masthead__wordmark {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: var(--step-4);
    line-height: 1;
  }
  .compact .masthead__wordmark {
    font-size: var(--step-2);
  }
  .masthead__meta {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .masthead__meta a {
    color: var(--accent);
    font-weight: 600;
  }
  .masthead__sep {
    color: var(--rule);
  }

  @media (max-width: 640px) {
    .masthead__wordmark {
      font-size: var(--step-3);
    }
    .masthead__meta {
      width: 100%;
      font-size: 0.75rem;
    }
  }
  @media (max-width: 400px) {
    .masthead__date {
      display: none;
    }
    .masthead__date + .masthead__sep {
      display: none;
    }
  }
</style>
