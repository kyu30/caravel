---
import {SITE} from '../lib/site.js'

interface Props {
  compact?: boolean
}
const {compact = false} = Astro.props

const today = new Date().toLocaleDateString('en-US', {
  weekday: 'short',
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})
---

<div class:list={['masthead', {compact}]}>
  <div class="container masthead__inner">
    <a href="/" class="masthead__brand" aria-label={`${SITE.name} — home`}>
      <img
        class="masthead__logo"
        src="/caravel-logo.png"
        alt={SITE.name}
        width="800"
        height="400"
      />
    </a>

    <div class="masthead__meta">
      <span class="masthead__date">{today}</span>
      <span class="masthead__sep" aria-hidden="true">·</span>
      <span>Georgetown University</span>
      <span class="masthead__sep" aria-hidden="true">·</span>
      <a href={SITE.newsletterUrl}>Subscribe</a>
    </div>
  </div>
</div>

<style>
  .masthead {
    background: var(--paper);
    /* logo sits flush to the band edges — it defines the masthead height */
    padding-block: 0;
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    min-height: 80px;
  }
  .compact .masthead__inner {
    min-height: 80px;
  }
  .masthead__brand {
    display: inline-flex;
    line-height: 0;
  }
  .masthead__logo {
    width: auto;
    height: 80px;
    flex: none;
  }
  .compact .masthead__logo {
    height: 80px;
  }
  .masthead__meta {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .masthead__meta a {
    color: var(--accent);
    font-weight: 600;
  }
  .masthead__sep {
    color: var(--rule);
  }

  @media (max-width: 640px) {
    .masthead__inner,
    .compact .masthead__inner {
      min-height: 0;
      padding-block: 0.6rem;
    }
    .masthead__logo {
      height: 44px;
    }
    .masthead__meta {
      width: 100%;
      font-size: 0.75rem;
    }
  }
  @media (max-width: 400px) {
    .masthead__date {
      display: none;
    }
    .masthead__date + .masthead__sep {
      display: none;
    }
  }
</style>
