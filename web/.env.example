# Copy to `.env` and fill in after you create the Sanity project (see /SETUP.md).
#
# Until PUBLIC_SANITY_PROJECT_ID is set, the site runs on bundled sample content
# (src/lib/sampleData.ts) so you can develop the front end immediately.

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional. Only needed to preview unpublished drafts or to raise API rate limits.
# Create at https://www.sanity.io/manage → API → Tokens (Viewer role is enough).
SANITY_API_READ_TOKEN=
